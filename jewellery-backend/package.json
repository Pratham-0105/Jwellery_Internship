{
  "name": "jewellery-backend",
  "version": "1.0.0",
  "description": "Terrain Jewellery REST API — Node.js + Express + PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:migrate": "npx prisma migrate dev",
